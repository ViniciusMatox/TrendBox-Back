generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model plano {
  tipo  TipoPlano
  preco Float     @db.Float
  ID    Int       @id
  user  user[]
}

model user {
  ID       Int    @id @default(autoincrement())
  cpf      String @unique @db.VarChar(11)
  nome     String @db.VarChar(255)
  telefone String @db.VarChar(20)
  email    String @unique(map: "email") @db.VarChar(255)
  password String @db.VarChar(255)
  planoId  Int
  plano    plano  @relation(fields: [planoId], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "user_ibfk_1")

  @@index([planoId], map: "planoId")
}

enum TipoPlano {
  DIAMANTE
  OURO
  PRATA
}
